// Fills part of an RGBA8 surface from another surface that holds the same guest bytes with a
// different layout: another width, tiled or linear, another scale along an axis, or (with
// DEPTH_SOURCE) depth and stencil, or (with RGB8_SOURCE) three bytes to a pixel.

#version 450 core
#extension GL_EXT_samplerless_texture_functions : require

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
#ifdef DEPTH_SOURCE
layout(set = 0, binding = 0) uniform highp texture2D depth;
#ifdef STENCIL_BYTES
// The stencil, copied into a buffer a byte a texel (an image whose stencil is sampled could not
// be compressed on every GPU): stencil_at is where the copy begins and its row length
layout(set = 0, binding = 3) uniform lowp utextureBuffer stencil_bytes;
#else
layout(set = 0, binding = 1) uniform lowp utexture2D stencil;
#endif
#else
layout(set = 0, binding = 0) uniform highp texture2D source;
#endif
layout(set = 0, binding = 2, rgba8) uniform highp writeonly image2D dest;

layout(push_constant, std140) uniform RelayoutInfo {
    highp ivec2 dst_offset;  // Host texel of the first invocation
    highp ivec2 dst_extent;  // Host texels to go through
    highp int dst_eighths;   // Host texels per guest pixel of the destination, in eighths
    highp int src_eighths_x; // The same of the source along x and along y, where a surface may
    highp int src_eighths_y; // have half its scale
    highp int dst_width;     // Guest size and layout of the destination
    highp int dst_height;
    highp int dst_tiled;
    highp int src_width;     // Guest size and layout of the source
    highp int src_height;
    highp int src_tiled;
    highp int delta;         // Index of a guest pixel in the source minus its index in the
                             // destination. With RGB8_SOURCE: address of the destination minus
                             // address of the source, in bytes
    highp int first_pixel;   // Destination pixel indices to fill
    highp int end_pixel;
    highp ivec2 stencil_at;  // DEPTH_SOURCE: first byte of the stencil copy, its row length
};

// Whole-number division of values that are not negative, done in floating point. The pass runs
// for every host texel of the range, and a mobile GPU takes dozens of instructions over an
// integer division by a value that is not a constant. Exact for dividends below two million
// (the half added keeps the quotient clear of a whole number by more than the rounding error);
// a surface has at most 1024 x 1024 pixels of four bytes, and the byte offsets used below stay
// within that.
highp int Div(highp int a, highp int b) {
    return int((float(a) + 0.5) / float(b));
}

highp ivec2 Div(highp ivec2 a, highp int b) {
    return ivec2((vec2(a) + 0.5) / float(b));
}

highp ivec2 Div(highp ivec2 a, highp ivec2 b) {
    return ivec2((vec2(a) + 0.5) / vec2(b));
}

// The first host texel of a guest pixel, and the guest pixel a host texel belongs to, as in
// SurfaceScale
highp ivec2 FirstTexel(highp ivec2 pos, highp ivec2 eighths) {
    return (pos * eighths * 2 + 7) >> 4;
}

highp ivec2 GuestPixel(highp ivec2 texel, highp int eighths) {
    return Div(texel * 8 + 4, eighths);
}

// Tiled surfaces are stored as rows of 8x8 tiles from the top of the image down, with the
// pixels of a tile in Z-order. Linear surfaces are stored row by row from the bottom up.
// Positions are in guest pixels with y pointing up, as in the host images.

highp int PixelIndex(highp ivec2 pos, highp int width, highp int height, highp int tiled) {
    if (tiled == 0) {
        return pos.y * width + pos.x;
    }
    highp int row = height - 1 - pos.y;
    highp int x = pos.x & 7;
    highp int y = row & 7;
    highp int in_tile = (x & 1) | ((y & 1) << 1) | ((x & 2) << 1) | ((y & 2) << 2) |
                        ((x & 4) << 2) | ((y & 4) << 3);
    return ((row >> 3) * (width >> 3) + (pos.x >> 3)) * 64 + in_tile;
}

highp ivec2 PixelPosition(highp int index, highp int width, highp int height, highp int tiled) {
    if (tiled == 0) {
        highp int row = Div(index, width);
        return ivec2(index - row * width, row);
    }
    highp int tile = index >> 6;
    highp int in_tile = index & 63;
    highp int x = (in_tile & 1) | ((in_tile >> 1) & 2) | ((in_tile >> 2) & 4);
    highp int y = ((in_tile >> 1) & 1) | ((in_tile >> 2) & 2) | ((in_tile >> 3) & 4);
    highp int tiles_per_row = width >> 3;
    highp int tile_row = Div(tile, tiles_per_row);
    highp int row = tile_row * 8 + y;
    return ivec2((tile - tile_row * tiles_per_row) * 8 + x, height - 1 - row);
}

// The host texel of the source for a guest pixel of it and a place inside that pixel, given as
// the place the destination texel has inside its own guest pixel and the size of that.
highp ivec2 SourceTexel(highp int index, highp ivec2 in_pixel, highp ivec2 pixel_size) {
    highp ivec2 pos = PixelPosition(index, src_width, src_height, src_tiled);
    highp ivec2 eighths = ivec2(src_eighths_x, src_eighths_y);
    highp ivec2 low = FirstTexel(pos, eighths);
    highp ivec2 high = FirstTexel(pos + 1, eighths);
    return low + Div(in_pixel * (high - low), pixel_size);
}

void main() {
    highp ivec2 local = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(local, dst_extent))) {
        return;
    }
    highp ivec2 dst_coord = dst_offset + local;
    highp ivec2 dst_pixel = GuestPixel(dst_coord, dst_eighths);
    highp ivec2 dst_first = FirstTexel(dst_pixel, ivec2(dst_eighths));
    highp ivec2 in_pixel = dst_coord - dst_first;
    highp ivec2 pixel_size = FirstTexel(dst_pixel + 1, ivec2(dst_eighths)) - dst_first;

    highp int dst_index = PixelIndex(dst_pixel, dst_width, dst_height, dst_tiled);
    if (dst_index < first_pixel || dst_index >= end_pixel) {
        return;
    }

#ifdef RGB8_SOURCE
    // The destination pixel is four bytes of guest memory (alpha, blue, green, red). In the
    // source they lie in two neighbouring pixels of three bytes (blue, green, red): each byte
    // is taken from where it is.
    highp int first_byte = dst_index * 4 + delta;
    highp int first = first_byte / 3;
    if (first_byte < 0 || first + 1 >= src_width * src_height) {
        return;
    }
    highp vec3 one = texelFetch(source, SourceTexel(first, in_pixel, pixel_size), 0).bgr;
    highp vec3 two = texelFetch(source, SourceTexel(first + 1, in_pixel, pixel_size), 0).bgr;
    // The six bytes of the two pixels in guest order, of which four from the first one's
    // offset on are the destination's
    highp int skip = first_byte - first * 3;
    highp vec4 bytes = skip == 0 ? vec4(one, two.x)
                                 : (skip == 1 ? vec4(one.yz, two.xy) : vec4(one.z, two));
    imageStore(dest, dst_coord, bytes.wzyx);
#else
    highp int src_index = dst_index + delta;
    if (src_index < 0 || src_index >= src_width * src_height) {
        return;
    }
    highp ivec2 src_coord = SourceTexel(src_index, in_pixel, pixel_size);

#ifdef DEPTH_SOURCE
    highp uint depth_val = uint(texelFetch(depth, src_coord, 0).x * (exp2(32.0) - 1.0));
#ifdef STENCIL_BYTES
    lowp uint stencil_val =
        texelFetch(stencil_bytes, stencil_at.x + src_coord.y * stencil_at.y + src_coord.x).x;
#else
    lowp uint stencil_val = texelFetch(stencil, src_coord, 0).x;
#endif
    highp uvec4 components =
        uvec4(stencil_val, (uvec3(depth_val) >> uvec3(24u, 16u, 8u)) & 0x000000FFu);
    imageStore(dest, dst_coord, vec4(components) / (exp2(8.0) - 1.0));
#else
    imageStore(dest, dst_coord, texelFetch(source, src_coord, 0));
#endif
#endif
}
