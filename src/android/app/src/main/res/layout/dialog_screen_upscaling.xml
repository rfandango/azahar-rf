<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="@dimen/spacing_large"
    android:paddingTop="@dimen/spacing_large">

    <RadioGroup
        android:id="@+id/upscalers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal" />

    <TextView
        android:id="@+id/text_sharpness"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_med"
        tools:text="Upscaling Sharpness: 200%" />

    <com.google.android.material.slider.Slider
        android:id="@+id/slider_sharpness"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="@string/screen_upscaling_sharpness"
        android:stepSize="5"
        android:valueFrom="0"
        android:valueTo="200" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/check_bottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/screen_upscaling_bottom" />

    <TextView
        android:id="@+id/text_output"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/spacing_med"
        tools:text="Output Resolution: 100%" />

    <com.google.android.material.slider.Slider
        android:id="@+id/slider_output"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:contentDescription="@string/output_resolution"
        android:stepSize="5"
        android:valueFrom="30"
        android:valueTo="100" />

</LinearLayout>
